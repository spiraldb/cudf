+    #[case::u32_17(17)]
+    #[case::u32_24(24)]
+    #[case::u32_31(31)]
+    #[crate::test]
+    async fn test_bitpacked_widths_u32(#[case] bit_width: u8) -> VortexResult<()> {
+        let mut ctx = array_session().create_execution_ctx();
+        let mask = (1u64 << bit_width) - 1;
+        let values: Vec<u32> = (0..5000u64)
+            .map(|i| (i.wrapping_mul(0x9E37_79B9_7F4A_7C15) >> 17 & mask) as u32)
+            .collect();
+        let packed = BitPacked::encode(
+            &PrimitiveArray::new(Buffer::from(values.clone()), NonNullable).into_array(),
+            bit_width,
+            &mut ctx,
+        )?;
+        let array = FoR::try_new(packed.into_array(), Scalar::from(3u32))?
+            .into_array()
+            .slice(777..4777)?;
+        // Plain FoR(BitPacked) dispatches to the standalone unpack kernels; force fusion.
+        let mut cuda_ctx = CudaSession::create_execution_ctx(&cuda_session())?;
+        let plan = dispatch_plan(&array, &mut cuda_ctx).await?;
+        let canonical = plan.execute(array.len(), &mut cuda_ctx)?;
+        let result = CanonicalCudaExt::into_host(canonical).await?.into_array();
+        let expected: Vec<u32> = values[777..4777].iter().map(|v| v + 3).collect();
+        let expected = PrimitiveArray::new(Buffer::from(expected), NonNullable).into_array();
+        assert_arrays_eq!(expected, result, &mut ctx);
