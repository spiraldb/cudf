+// ---------------------------------------------------------------------------
+// Benchmark: FoR(BitPacked) bit-width sweep, one 16Mi-row zone
+// ---------------------------------------------------------------------------
+fn bench_bitpacked_width_sweep<T: DeviceRepr + NativePType + TryFrom<u64>>(
+    c: &mut Criterion,
+    widths: &[u8],
+) where
+    <T as TryFrom<u64>>::Error: std::fmt::Debug,
+{
+    let mut group = c.benchmark_group("cuda");
+    let len = 16usize << 20;
+    group.throughput(Throughput::Bytes((len * size_of::<T>()) as u64));
+    for &bit_width in widths {
+        let mask = (1u64 << bit_width) - 1;
+        let values: Vec<T> = (0..len)
+            .map(|i| T::try_from(((i as u64).wrapping_mul(0x9E37_79B9_7F4A_7C15) >> 13) & mask).unwrap())
+            .collect();
+        let prim = PrimitiveArray::new(Buffer::from(values), NonNullable);
+        let mut ctx = array_session().create_execution_ctx();
+        let array = BitPackedData::encode(&prim.into_array(), bit_width, &mut ctx)
+            .vortex_expect("bitpack")
+            .into_array();
+        let name = format!("cuda/bitpacked_{bit_width}bw/dispatch_{}", T::PTYPE);
+        group.bench_with_input(BenchmarkId::new(name, "16Mi"), &len, |b, &n| {
+            let mut cuda_ctx =
+                CudaSession::create_execution_ctx(&cuda_session()).vortex_expect("ctx");
+            let mut bench_runner = BenchRunner::<T>::new(&array, n, &mut cuda_ctx);
+            b.iter_custom(|iters| {
+                let mut total_time = Duration::ZERO;
+                for _ in 0..iters {
+                    total_time += bench_runner.run(&mut cuda_ctx);
+                }
+                total_time
+            });
+        });
+    }
+    group.finish();
+}
+
+// ---------------------------------------------------------------------------
+// Benchmark: ALP(FoR(BitPacked)) — f64, 24-bit random integers, one 16Mi-row zone
+// ---------------------------------------------------------------------------
+fn bench_alp_for_bitpacked_f64_wide(c: &mut Criterion) {
+    let mut ctx = array_session().create_execution_ctx();
+    let mut group = c.benchmark_group("cuda");
+
+    let exponents = Exponents { e: 2, f: 0 };
+    let bit_width: u8 = 24;
+    let len = 16usize << 20;
+    group.throughput(Throughput::Bytes((len * size_of::<f64>()) as u64));
+
+    for (patch_interval, benchmark_name) in [
+        (None, "cuda/alp_for_bp_24bw_f64/dispatch_f64"),
+        (Some(10), "cuda/alp_for_bp_24bw_f64_10pct_patches/dispatch_f64"),
+        (Some(5), "cuda/alp_for_bp_24bw_f64_20pct_patches/dispatch_f64"),
+    ] {
+        let floats: Vec<f64> = (0..len)
+            .map(|i| {
+                let hashed = (i as u64).wrapping_mul(0x9E37_79B9_7F4A_7C15) >> 40;
+                if patch_interval.is_some_and(|interval| hashed % interval == 0) {
+                    PI
+                } else {
+                    <f64 as ALPFloat>::decode_single(hashed as i64, exponents)
+                }
+            })
+            .collect();
+        let float_prim = PrimitiveArray::new(Buffer::from(floats), NonNullable);
+        let alp =
+            alp_encode(float_prim.as_view(), Some(exponents), &mut ctx).vortex_expect("alp_encode");
+        let (encoded, alp_exponents, patches) = alp.into_parts();
+        let for_arr = FoRData::encode(
+            encoded
+                .execute::<PrimitiveArray>(&mut ctx)
+                .vortex_expect("to primitive"),
+            &mut ctx,
+        )
+        .vortex_expect("for encode");
+        let bp = BitPackedData::encode(for_arr.encoded(), bit_width, &mut ctx)
+            .vortex_expect("bitpack encode");
+        let array = ALP::new(
+            FoR::try_new(bp.into_array(), for_arr.reference_scalar().clone())
+                .vortex_expect("for_new")
+                .into_array(),
+            alp_exponents,
+            patches,
+        )
+        .into_array();
+
+        group.bench_with_input(BenchmarkId::new(benchmark_name, "16Mi"), &len, |b, &n| {
+            let mut cuda_ctx =
+                CudaSession::create_execution_ctx(&cuda_session()).vortex_expect("ctx");
+            let mut bench_runner = BenchRunner::<u64>::new(&array, n, &mut cuda_ctx);
+            b.iter_custom(|iters| {
+                let mut total_time = Duration::ZERO;
+                for _ in 0..iters {
+                    total_time += bench_runner.run(&mut cuda_ctx);
+                }
+                total_time
+            });
+        });
+    }
+
+    group.finish();
+}
