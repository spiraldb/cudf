+/// Unpack one FastLanes chunk with every thread of the block, for types with fewer lanes than
+/// threads (u32 and u64). Unpacking whole lanes would leave the other threads idle, and the
+/// busy ones each walk a lane's packed words serially; instead each thread extracts single
+/// values. Row `row` of lane `lane` occupies bits `[row * bw, row * bw + bw)` of the lane's
+/// word sequence `packed[lane], packed[lane + lanes], ...`.
+template <typename T>
+__device__ inline void bit_unpack_chunk_parallel(const T *__restrict packed, T *__restrict dst, uint32_t bw) {
+    constexpr uint32_t WORD_BITS = sizeof(T) * 8;
+    constexpr uint32_t LANES = FL_LANES<T>;
+    for (uint32_t element = threadIdx.x; element < FL_CHUNK; element += blockDim.x) {
+        const uint32_t lane = element % LANES;
+        const uint32_t row = element / LANES;
+        T value = 0;
+        if (bw == WORD_BITS) {
+            value = packed[row * LANES + lane];
+        } else if (bw > 0) {
+            const uint32_t bit = row * bw;
+            const uint32_t word = bit / WORD_BITS;
+            const uint32_t shift = bit % WORD_BITS;
+            value = packed[word * LANES + lane] >> shift;
+            if (shift + bw > WORD_BITS) {
+                value |= packed[(word + 1) * LANES + lane] << (WORD_BITS - shift);
+            }
+            value &= MASK(T, bw);
+        }
+        dst[INDEX(row, lane)] = value;
+    }
+}
