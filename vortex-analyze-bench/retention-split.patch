+    /// Blocks subsequent stream work without calling CUDA from the driver callback.
+    /// Dropping the sender releases the callback, including during test unwinding.
+    fn block_stream(stream: &VortexCudaStream) -> VortexResult<std::sync::mpsc::Sender<()>> {
+        use std::sync::mpsc;
+        use std::time::Duration;
+
+        stream
+            .context()
+            .bind_to_thread()
+            .map_err(|e| vortex_err!("Failed to bind CUDA context: {e}"))?;
+        let (started_tx, started_rx) = mpsc::channel::<()>();
+        let (release_tx, release_rx) = mpsc::channel::<()>();
+        let state = Box::into_raw(Box::new((started_tx, release_rx)));
+        unsafe extern "C" fn callback(data: *mut std::ffi::c_void) {
+            // SAFETY: Registration transfers this box to the callback exactly once.
+            let state =
+                unsafe { Box::from_raw(data.cast::<(mpsc::Sender<()>, mpsc::Receiver<()>)>()) };
+            let _ = state.0.send(());
+            // A CUDA error may synchronize the gated stream before returning to the test.
+            // Bound that failure path rather than stranding the driver callback indefinitely.
+            let _ = state.1.recv_timeout(Duration::from_secs(30));
+        }
+        // SAFETY: The borrowed stream is live, the callback has the required ABI, and
+        // its box remains owned until the callback runs (or registration fails).
+        let registered = unsafe {
+            result::stream::launch_host_function(stream.cu_stream(), callback, state.cast())
+        };
+        if let Err(error) = registered {
+            // SAFETY: A failed registration cannot invoke the callback.
+            drop(unsafe { Box::from_raw(state) });
+            return Err(vortex_err!("Failed to register stream gate: {error}"));
+        }
+        started_rx
+            .recv_timeout(Duration::from_secs(5))
+            .map_err(|e| vortex_err!("Stream gate did not start: {e}"))?;
+        Ok(release_tx)
+    }
