+    #[crate::test]
+    fn context_bind_failure_after_drain_retains_source() -> VortexResult<()> {
+        let (pool, stream) = setup()?;
+        let mut pinned = pool.get(1024)?;
+        pinned.as_mut_slice().fill(0xAB);
+        let allocation = pinned.inner.as_ref().unwrap().ptr;
+        let destination = pinned.transfer_to_device(&stream)?;
+        stream
+            .synchronize()
+            .map_err(|e| vortex_err!("Failed to sync stream: {e}"))?;
+        pool.reclaimer.lock().fail_next_bind = true;
+        assert!(pool.try_get(1024).is_err());
+        {
+            let reclaimer = pool.reclaimer.lock();
+            assert!(pool.inflight.lock().is_empty());
+            assert!(reclaimer.handoff.is_empty());
+            assert_eq!(reclaimer.pending.len(), 1);
+            assert_eq!(reclaimer.pending[0].buffer.ptr, allocation);
+            assert!(reclaimer.pending[0].buffer.pending_transfer);
+        }
+        assert_eq!(pool.stats().puts, 0);
+        let reused = pool
+            .try_get(1024)?
+            .vortex_expect("source was lost after bind failure");
+        assert_eq!(reused.inner.as_ref().unwrap().ptr, allocation);
+        assert!(!reused.inner.as_ref().unwrap().pending_transfer);
+        assert_no_retained_sources(&pool);
+        assert!(pool.try_get(1024)?.is_none());
+        assert_eq!(pool.stats().puts, 1);
+        assert_eq!(pool.stats().hits, 1);
+        assert_eq!(pool.stats().allocs, 1);
+        let host = destination.copy_to_host_sync(Alignment::of::<u8>())?;
+        assert_eq!(host.as_ref(), vec![0xAB; 1024]);
+        Ok(())
+    }
