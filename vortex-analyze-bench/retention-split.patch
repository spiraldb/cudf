+    #[crate::test]
+    fn concurrent_acquisition_drains_sources_once() -> VortexResult<()> {
+        use std::collections::HashSet;
+        use std::sync::Barrier;
+
+        const COUNT: usize = 8;
+        let (pool, stream) = setup()?;
+        let mut sources = Vec::new();
+        for _ in 0..COUNT {
+            let mut source = pool.get(1024)?;
+            source.as_mut_slice().fill(0xAB);
+            sources.push(source);
+        }
+        let allocations: HashSet<_> = sources
+            .iter()
+            .map(|source| source.inner.as_ref().unwrap().ptr as usize)
+            .collect();
+        assert_eq!(allocations.len(), COUNT);
+        let mut destinations = Vec::new();
+        for source in sources {
+            destinations.push(source.transfer_to_device(&stream)?);
+        }
+        stream
+            .synchronize()
+            .map_err(|e| vortex_err!("Failed to sync stream: {e}"))?;
+        assert_eq!(pool.inflight.lock().len(), COUNT);
+
+        let start = Arc::new(Barrier::new(COUNT + 1));
+        let scanner = pool.reclaimer.lock();
+        let mut workers = Vec::new();
+        for _ in 0..COUNT {
+            let pool = Arc::clone(&pool);
+            let start = Arc::clone(&start);
+            workers.push(std::thread::spawn(move || {
+                start.wait();
+                pool.try_get(1024)
+            }));
+        }
+        start.wait();
+        drop(scanner);
+        // Keep every acquisition alive until all workers finish, so reuse cannot mask duplicates.
+        let acquired = workers
+            .into_iter()
+            .map(|worker| {
+                worker
+                    .join()
+                    .ok()
+                    .vortex_expect("acquisition worker panicked")
+            })
+            .collect::<VortexResult<Vec<_>>>()?;
+        let reused: HashSet<_> = acquired
+            .iter()
+            .map(|buffer| {
+                let inner = buffer
+                    .as_ref()
+                    .vortex_expect("source was lost")
+                    .inner
+                    .as_ref()
+                    .unwrap();
+                assert!(!inner.pending_transfer);
+                inner.ptr as usize
+            })
+            .collect();
+        assert_eq!(reused, allocations);
+        assert_no_retained_sources(&pool);
+        assert_eq!(pool.stats().allocs, COUNT as u64);
+        assert_eq!(pool.stats().hits, COUNT as u64);
+        assert_eq!(pool.stats().puts, COUNT as u64);
+        pool.reclaim_completed()?;
+        assert_eq!(pool.stats().puts, COUNT as u64);
+        Ok(())
+    }
