+    #[crate::test]
+    fn retention_finishes_while_scanner_lock_is_held() -> VortexResult<()> {
+        use std::sync::mpsc;
+        use std::time::Duration;
+
+        let (pool, stream) = setup()?;
+        let mut pinned = pool.get(1024)?;
+        pinned.as_mut_slice().fill(0xAB);
+        let mut destination = stream.device_alloc::<u8>(1024)?;
+        let scanner = pool.reclaimer.lock();
+        let (finished_tx, finished_rx) = mpsc::channel();
+        let (completed_tx, completed_rx) = mpsc::channel();
+        let worker = std::thread::spawn(move || {
+            let result = pinned.copy_to_device(&stream, 0..1024, &mut destination.slice_mut(..));
+            let _ = finished_tx.send(result.is_ok());
+            let _ = completed_tx.send(());
+            (result, destination)
+        });
+        let finished = finished_rx.recv_timeout(Duration::from_secs(5));
+        // Always release before asserting or joining, including on timeout/failure.
+        drop(scanner);
+        completed_rx
+            .recv_timeout(Duration::from_secs(5))
+            .ok()
+            .vortex_expect("transfer did not finish after releasing the scanner lock");
+        let (result, destination) = worker.join().ok().vortex_expect("transfer worker panicked");
+        assert!(
+            finished
+                .ok()
+                .vortex_expect("retention waited for the scanner lock")
+        );
+        result?;
+        assert_eq!(pool.inflight.lock().len(), 1);
+        assert!(pool.reclaimer.lock().pending.is_empty());
+        let host = CudaDeviceBuffer::new(destination).copy_to_host_sync(Alignment::of::<u8>())?;
+        assert_eq!(host.as_ref(), vec![0xAB; 1024]);
+        Ok(())
+    }
