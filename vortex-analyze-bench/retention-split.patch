+    #[rstest]
+    #[crate::test]
+    fn incomplete_source_stays_pending_until_gate_releases(
+        #[values(false, true)] automatic_tracking: bool,
+    ) -> VortexResult<()> {
+        let (pool, stream) = setup()?;
+        if !automatic_tracking {
+            // SAFETY: The destination stays on its allocation stream. The pool's explicit
+            // event must protect the source even with automatic tracking disabled.
+            unsafe { stream.context().disable_event_tracking() };
+        }
+        let mut pinned = pool.get(1024)?;
+        pinned.as_mut_slice().fill(0xAB);
+        let allocation = pinned.inner.as_ref().unwrap().ptr;
+        let mut destination = stream.device_alloc::<u8>(1024)?;
+        let gate = block_stream(&stream)?;
+        pinned.copy_to_device(&stream, 0..1024, &mut destination.slice_mut(..))?;
+
+        // Both the first drain and a subsequent empty drain must preserve the source.
+        for _ in 0..2 {
+            assert!(pool.try_get(1024)?.is_none());
+            let reclaimer = pool.reclaimer.lock();
+            assert!(pool.inflight.lock().is_empty());
+            assert!(reclaimer.handoff.is_empty());
+            assert_eq!(reclaimer.pending.len(), 1);
+            assert_eq!(reclaimer.pending[0].buffer.ptr, allocation);
+            assert!(reclaimer.pending[0].buffer.pending_transfer);
+            assert!(!reclaimer.pending[0].buffer.event.is_complete());
+        }
+        assert_eq!(pool.stats().puts, 0);
+        assert_eq!(pool.stats().allocs, 1);
+        drop(gate);
+        stream
+            .synchronize()
+            .map_err(|e| vortex_err!("Failed to sync stream: {e}"))?;
+        let mut reused = pool
+            .try_get(1024)?
+            .vortex_expect("completed source was not reused");
+        assert_eq!(reused.inner.as_ref().unwrap().ptr, allocation);
+        assert!(!reused.inner.as_ref().unwrap().pending_transfer);
+        assert_no_retained_sources(&pool);
+        assert_eq!(pool.stats().puts, 1);
+        reused.as_mut_slice().fill(0xCD);
+        let host = CudaDeviceBuffer::new(destination).copy_to_host_sync(Alignment::of::<u8>())?;
+        assert_eq!(host.as_ref(), vec![0xAB; 1024]);
+        pool.reclaim_completed()?;
+        assert_eq!(pool.stats().puts, 1);
+        Ok(())
+    }
