+#[rstest]
+#[case::single_chunk(31)]
+#[case::multichunk(2 * FILE_READ_CHUNK_BYTES + 19)]
+#[crate::test]
+async fn uploads_progress_without_repolling_read(#[case] length: usize) -> VortexResult<()> {
+    let (backend, mut blocked) = FakeFileReadBackend::default().blocking();
+    let (_runtime, mut reader) = reader(backend)?;
+    let chunk_count = length.div_ceil(FILE_READ_CHUNK_BYTES);
+    reader.read_slots = Arc::new(Semaphore::new(chunk_count));
+    let mut read = reader.read_at(FILE_OFFSET, length, Alignment::of::<u8>());
+    assert!(poll!(&mut read).is_pending());
+
+    let mut chunks = Vec::new();
+    for _ in 0..chunk_count {
+        chunks.push(next_read(&mut blocked).await);
+    }
+    assert_eq!(reader.read_slots.available_permits(), 0);
+    let puts = reader.pool.stats().puts;
+    for chunk in chunks {
+        chunk.finish().await;
+    }
+
+    // Backend completion alone does not acknowledge submission. Workers must enqueue H2D
+    // before releasing their slots, without another poll of `read`.
+    assert_slots_released(&reader, u32::try_from(chunk_count)?).await;
+    reader
+        .stream
+        .synchronize()
+        .map_err(|error| vortex_err!("Failed to sync upload stream: {error}"))?;
+
+    // try_get reclaims completed transfers. Caller-driven submission instead leaves the
+    // sources in the unpolled read future, so neither reuse nor these puts can occur.
+    let reused = reader.pool.try_get(length.min(FILE_READ_CHUNK_BYTES))?;
+    assert_eq!(
+        reader.pool.stats().puts - puts,
+        chunk_count as u64,
+        "all upload sources must be reclaimable before repolling the read"
+    );
+    assert!(reused.is_some(), "an upload source must be reusable");
+    drop(reused);
+
+    let buffer = wait_for("read did not finish after worker uploads", read).await?;
+    assert_bytes(buffer, FILE_OFFSET, length).await
+}
