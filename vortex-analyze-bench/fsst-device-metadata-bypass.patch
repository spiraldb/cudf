+// BENCHMARK ONLY: serialized symbols already have the u64 layout consumed by the kernel.
+// Retain device metadata instead of reading it back and uploading it again. Kernel arguments
+// still use managed views, preserving producer-write dependencies and allocation lifetimes.
+fn symbol_buffers(fsst: &FSSTArray) -> (BufferHandle, BufferHandle) {
+    if let Some(buffers) = fsst.device_symbol_buffers() {
+        return buffers;
+    }
+    let symbols = Buffer::from(
+        fsst.symbols()
+            .iter()
+            .map(|symbol| symbol.to_u64())
+            .collect::<Vec<_>>(),
+    );
+    let lengths = fsst.padded_symbol_lengths().slice(0..fsst.n_symbols());
+    (
+        BufferHandle::new_host(symbols.into_byte_buffer()),
+        BufferHandle::new_host(lengths.into_byte_buffer()),
+    )
+}
